msgstr "Fragmento actualizado."

#: src/Controller/Admin/SnippetController.php:157
msgid "Snippet activated."
msgstr "Fragmento activado."

#: src/Controller/Admin/SnippetController.php:184
msgid "Snippet deactivated."
msgstr "Fragmento desactivado."

#: src/Controller/Admin/SnippetController.php:209
msgid "Snippet deleted."
msgstr "Fragmento eliminado."

