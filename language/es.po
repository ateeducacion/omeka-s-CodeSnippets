#: view/code-snippets/admin/snippet/delete.phtml:16
msgid "Delete snippet"
msgstr "Eliminar fragmento"

#: view/code-snippets/admin/snippet/delete.phtml:20
#: view/code-snippets/admin/snippet/index.phtml:25
#: view/code-snippets/admin/snippet/form.phtml:25
msgid "Safe mode is active. PHP snippets are not being executed."
msgstr "El modo seguro está activo. No se están ejecutando fragmentos PHP."

#: view/code-snippets/admin/snippet/delete.phtml:26
#, php-format
msgid ""
"Are you sure you want to delete the snippet \"%s\" (ID %s)? This cannot be "
"undone."
msgstr ""
"¿Seguro que desea eliminar el fragmento «%s» (ID %s)? Esta acción no se "
"puede deshacer."

