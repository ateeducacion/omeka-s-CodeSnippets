msgid "PHP run on each HTTP request when active. Opening <?php is optional."
msgstr "PHP que se ejecuta en cada petición HTTP cuando está activo. La etiqueta de apertura <?php es opcional."

#: src/Form/SnippetForm.php:67
msgid "Lower numbers execute first. Default is 10."
msgstr "Los números más bajos se ejecutan primero. El valor predeterminado es 10."

