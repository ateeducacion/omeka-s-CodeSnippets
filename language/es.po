#: src/Controller/Admin/SnippetController.php:252
msgid "You are not allowed to manage code snippets."
msgstr "No tiene permiso para gestionar fragmentos de código."

#: src/Controller/Admin/SnippetController.php:290
msgid "Method not allowed."
msgstr "Método no permitido."

#: src/Form/SnippetForm.php:24
msgid "Display name of the snippet. Names do not need to be unique."
msgstr "Nombre visible del fragmento. Los nombres no tienen que ser únicos."

#: src/Form/SnippetForm.php:36
msgid "Description"
msgstr "Descripción"

#: src/Form/SnippetForm.php:37
msgid "Optional description of what this snippet does."
msgstr "Descripción opcional de lo que hace este fragmento."

#: src/Form/SnippetForm.php:49
msgid "PHP code"
msgstr "Código PHP"

#: src/Form/SnippetForm.php:50
msgid ""
"PHP run on matching HTTP requests when active. Opening <?php is optional."
msgstr ""
"PHP que se ejecuta en las peticiones HTTP coincidentes cuando está activo. "
"La etiqueta de apertura <?php es opcional."

#: src/Form/SnippetForm.php:68
msgid "Lower numbers execute first. Default is 10."
msgstr ""
"Los números más bajos se ejecutan primero. El valor predeterminado es 10."

#: src/Form/SnippetForm.php:82
msgid ""
"Choose whether this snippet runs on the public site, in the admin, or both."
msgstr ""
"Elija si este fragmento se ejecuta en el sitio público, en el administrador "
"o en ambos."

#: src/Form/SnippetForm.php:96
msgid "Execute this snippet on HTTP requests."
msgstr "Ejecutar este fragmento en las peticiones HTTP."

#: src/Controller/Admin/SnippetController.php:69
msgid "Snippet created."
msgstr "Fragmento creado."

#: src/Controller/Admin/SnippetController.php:120
