<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array<string, mixed> $snippet
 * @var bool $safeModeActive
 * @var array<string, string> $safeModeQuery
 * @var string $actionCsrf
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');

$this->htmlElement('body')->appendAttribute('class', 'code-snippets delete');
$csCss = \CodeSnippets\View\EditorAssets::contents('asset/css/code-snippets.css');
?>
<?php if ($csCss !== ''): ?>
<style><?php echo $csCss; ?></style>
<?php endif; ?>
<?php echo $this->pageTitle($translate('Delete snippet')); ?>

<?php if (!empty($safeModeActive)): ?>
<div class="messages" role="status">
    <p class="warning"><?php echo $escape($translate('Safe mode is active. PHP snippets are not being executed.')); ?></p>
</div>
<?php endif; ?>

<p>
    <?php echo $escape(sprintf(
        $translate('Are you sure you want to delete the snippet "%s" (ID %s)? This cannot be undone.'),
        $snippet['name'],
        $snippet['id']
    )); ?>
</p>

<form method="post" action="<?php echo $escapeAttr($this->url('admin/code-snippets/delete', ['id' => $snippet['id']], ['query' => $safeModeQuery])); ?>">
    <input type="hidden" name="csrf" value="<?php echo $escapeAttr($actionCsrf); ?>">
    <div id="page-actions">
        <button type="submit" class="delete"><?php echo $escape($translate('Delete')); ?></button>
        <?php echo $this->hyperlink(
            $translate('Cancel'),
            $this->url('admin/code-snippets', [], ['query' => $safeModeQuery]),
            ['class' => 'button']
        ); ?>
    </div>
</form>
