{
  "$schema": "https://omeka-s-contrib.github.io/omeka-s-blueprints/schema/v0/blueprint-schema.json",
  "install": {
    "title": "CodeSnippets Playground",
    "locale": "es",
    "timezone": "Atlantic/Canary"
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "password": "password",
      "role": "global_admin"
    },
    {
      "username": "editor",
      "email": "editor@example.com",
      "password": "1234",
      "role": "editor"
    }
  ],
  "modules": [
    {
      "name": "CodeSnippets",
      "state": "activate",
      "source": "https://github.com/ateeducacion/omeka-s-CodeSnippets/archive/refs/heads/main.zip"
    }
  ],
  "sites": [
    {
      "title": "CodeSnippets Demo",
      "slug": "demo",
      "theme": "default",
      "summary": "Try CodeSnippets after install: WordPress-style example snippets are seeded, and the current-year footer snippet is active in this playground.",
      "isPublic": true,
      "setAsDefault": true
    }
  ],
  "x-playground": {
    "debug": {
      "enabled": true
    },
    "phpConstants": {
      "CODE_SNIPPETS_PLAYGROUND": true
    },
    "landingPage": "/admin/code-snippets"
  }
}
