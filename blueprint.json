{
  "$schema": "https://ateeducacion.github.io/omeka-s-playground/assets/blueprints/blueprint-schema.json",
  "debug": {
    "enabled": true
  },
  "phpConstants": {
    "CODE_SNIPPETS_PLAYGROUND": true
  },
  "landingPage": "/admin/code-snippets",
  "siteOptions": {
    "title": "CodeSnippets Playground",
    "locale": "es",
    "timezone": "Atlantic/Canary"
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "password": "password",
      "role": "global_admin"
    }
  ],
  "modules": [
    {
      "name": "CodeSnippets",
      "state": "activate",
      "source": {
        "type": "url",
        "url": "https://github.com/ateeducacion/omeka-s-CodeSnippets/archive/refs/heads/main.zip"
      }
    }
  ],
  "site": {
    "title": "CodeSnippets Demo",
    "slug": "demo",
    "theme": "default",
    "summary": "Try CodeSnippets after install: WordPress-style example snippets are seeded, and the current-year footer snippet is active in this playground.",
    "isPublic": true,
    "setAsDefault": true
  }
}
